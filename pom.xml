<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.tfminecraft</groupId>
    <artifactId>cooking</artifactId>
    <version>0.1.5-ALPHA</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <tfmc.refs>D:/Documents/TFMC/ReferenceLibs</tfmc.refs>
        <tfmc.builds>D:/Documents/TFMC/Builds/Cooking</tfmc.builds>
        <tfmc.tlibs>D:/Documents/TFMC/Builds/TLibs</tfmc.tlibs>
        <tfmc.if>D:/Documents/TFMC/Builds/InteractibleFurniture</tfmc.if>
        <tfmc.tfmccore>D:/Documents/TFMC/Builds/TFMCCore</tfmc.tfmccore>
        <tfmc.plugins>D:/Documents/TFMC/Workspace/plugins</tfmc.plugins>
        <tfmc.sf>D:/Documents/TFMC/Builds/SimpleFactions</tfmc.sf>
    </properties>

    <dependencies>
        <dependency>
            <groupId>local</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>system</scope>
            <systemPath>${tfmc.refs}/gson-2.10.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.21.8</version>
            <scope>system</scope>
            <systemPath>${tfmc.refs}/spigot-api.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>TLibs</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${tfmc.tlibs}/TLibs.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>joml</artifactId>
            <version>1.10.8</version>
            <scope>system</scope>
            <systemPath>${tfmc.refs}/joml-1.10.8.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>InteractibleFurniture</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${tfmc.if}/interactiblefurniture-0.1.3-BETA.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>TFMCCore</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${tfmc.tfmccore}/TFMCCore.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>RPCharacters</artifactId>
            <version>1.1.6</version>
            <scope>system</scope>
            <systemPath>${tfmc.refs}/rpcharacters-1.1.6.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>MythicLib</artifactId>
            <version>1.7</version>
            <scope>system</scope>
            <systemPath>${tfmc.refs}/MythicLib-1.7.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>MMOCore</artifactId>
            <version>1.13.1</version>
            <scope>system</scope>
            <systemPath>${tfmc.refs}/MMOCore-1.13.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>CustomCrops</artifactId>
            <version>3.6.49</version>
            <scope>system</scope>
            <systemPath>${tfmc.plugins}/CustomCrops-3.6.49.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>SimpleFactions</artifactId>
            <version>2.8.7</version>
            <scope>system</scope>
            <systemPath>${tfmc.sf}/simplefactions-2.8.7.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>commons-lang</groupId>
            <artifactId>commons-lang</artifactId>
            <version>2.6</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${tfmc.builds}"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                    tofile="${tfmc.builds}/${project.build.finalName}.jar"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
